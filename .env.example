# Copy to .env and replace all development credentials before deployment.
POSTGRES_DB=recallnote
POSTGRES_USER=recallnote
POSTGRES_PASSWORD=change-me-local-only
DB_HOST=postgres
DB_PORT=5432
DB_NAME=recallnote
DB_USER=recallnote
DB_PASSWORD=change-me-local-only
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
AGENT_BASE_URL=http://agent-api:8000
INTERNAL_API_KEY=change-me-internal-local-only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AGENT_MODE=mock
DEV_USER_ID=dev-user-001
DEV_USER_ENABLED=true

# Google OAuth: production requires DEV_USER_ENABLED=false and HTTPS.
PUBLIC_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_COOKIE_SECURE=false
